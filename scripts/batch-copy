#!/usr/bin/env bash
# batch-copy — resumable batch copy/upload of files through GNU parallel.
#
# Expands files and directories into one job per file, then runs the copy
# command for each through batch-run: an interrupted batch resumes, failed
# files retry on the next run, and files that already copied never run
# again. Every job lands in a persistent joblog.
#
# Usage:
#   batch-copy [OPTIONS] LOG SRC... -- COMMAND...
#
#   COMMAND runs once per file. {} is the file path, {/} its basename,
#   {//} its directory, {.}/{/.} the variants without extension.
#
# Options (then batch-run's, which are forwarded):
#   --jobs N       concurrent jobs (default: 4)
#   --delay SECS   seconds between job starts, for rate-limited remotes
#   --fresh        discard the joblog and start the batch over
#   -h, --help     this help
#
# Examples:
#   # each file into the Wayback Machine (pkit stages and captures per file)
#   batch-copy logs/wayback-2026-10.tsv software/pcsx2/ -- pkit archive copy "{}" "wayback:{//}"
#
#   set -euo pipefail

die() {
        echo "batch-copy: $*" >&2
        exit 2
}

usage() {
        sed -e '1d' -e '/^[^#]/,$d' "$0" | sed 's/^# \{0,1\}//'
}

self_dir=$(dirname -- "$(readlink -f -- "$0")")
log="" jobs=4 delay=0 fresh=0
sources=()
while [ $# -gt 0 ]; do
        case $1 in
        --jobs | --delay)
                [ $# -ge 2 ] || die "$1 needs a value"
                if [ "$1" = "--jobs" ]; then jobs=$2; else delay=$2; fi
                shift 2
                ;;
        --fresh)
                fresh=1
                shift
                ;;
        -h | --help)
                usage
                exit 0
                ;;
        --)
                shift
                break
                ;;
        --*)
                die "unknown option: $1"
                ;;
        *)
                if [ -z "$log" ]; then
                        log=$1
                else
                        sources+=("$1")
                fi
                shift
                ;;
        esac
done

[ -n "$log" ] || die "usage: batch-copy [OPTIONS] LOG SRC... -- COMMAND..."
[ "${#sources[@]}" -ge 1 ] || die "no SRC given (a file or directory to copy from)"
[ $# -ge 1 ] || die "no COMMAND given after -- (the copy adapter, e.g. 'rclone copyto {} remote:{/}')"
[ -x "$self_dir/batch-run" ] || die "batch-run not found next to this script"

# One file per job: directories expand recursively, plain files pass through.
items=$(mktemp)
trap 'rm -f -- "$items"' EXIT
for src in "${sources[@]}"; do
        if [ -d "$src" ]; then
                find "$src" -type l -print0 >>"$items"
        elif [ -e "$src" ] || [ -L "$src" ]; then
                printf '%s\0' "$src" >>"$items"
        else
                die "no such file or directory: $src"
        fi
done
[ -s "$items" ] || die "no files found in: ${sources[*]}"

extra=()
[ "$fresh" -eq 1 ] && extra+=(--fresh)

exec "$self_dir/batch-run" \
        --log "$log" --jobs "$jobs" --delay "$delay" \
        ${extra[@]+"${extra[@]}"} \
        -- "$@" <"$items"
