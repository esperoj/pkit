#!/usr/bin/env bash
# batch-run — run one command per stdin item through GNU parallel, with a
# persistent joblog: interrupted batches resume, failed jobs retry, and
# succeeded jobs never run twice.
#
# Items arrive on stdin, NUL-separated (find ... -print0) or one per line.
# The command template runs once per item and may use GNU parallel's
# replacement strings:
#
#   {}    the whole item            {/}   basename
#   {//}  dirname                   {.}   item without extension
#   {/.}  basename without extension
#
# Usage:
#   producer | batch-run [OPTIONS] -- COMMAND...
#
# Options:
#   --log FILE     joblog recording every job (required; one per batch)
#   --jobs N       concurrent jobs (default: 4)
#   --delay SECS   seconds between job starts, for rate-limited remotes
#   --fresh        discard the existing joblog and start the batch over
#   -h, --help     this help
#
# Resume and retry: re-running with the same --log skips items that
# succeeded and retries the failed ones (parallel's --resume-failed).
# The log keys on the items, not the command: give a batch that runs a
# different command its own log, or pass --fresh.
#
# Job-log lifecycle: one log per batch or time period, for example
# logs/copy-2026-10.tsv. Archive or delete a log only after a run reports
# "0 failed":
#
#   mkdir -p logs/done && mv logs/copy-2026-10.tsv logs/done/
#
# Output: each job's stdout/stderr is tagged with its command and printed
# live. A summary goes to stderr. Exit status: 0 when every job of this
# run succeeded, 1 when any failed, 2 for usage errors or missing tools.
#
# Requires: GNU parallel (and perl, its runtime).
set -euo pipefail

die() {
        echo "batch-run: $*" >&2
        exit 2
}

usage() {
        sed -e '1d' -e '/^[^#]/,$d' "$0" | sed 's/^# \{0,1\}//'
}

log="" jobs=4 delay=0 fresh=0
while [ $# -gt 0 ]; do
        case $1 in
        --log)
                [ $# -ge 2 ] || die "--log needs a file path"
                log=$2
                shift 2
                ;;
        --jobs)
                [ $# -ge 2 ] || die "--jobs needs a number"
                jobs=$2
                shift 2
                ;;
        --delay)
                [ $# -ge 2 ] || die "--delay needs seconds"
                delay=$2
                shift 2
                ;;
        --fresh)
                fresh=1
                shift
                ;;
        -h | --help)
                usage
                exit 0
                ;;
        --)
                shift
                break
                ;;
        --*)
                die "unknown option: $1"
                ;;
        *)
                die "options first, then -- COMMAND (unexpected: $1)"
                ;;
        esac
done

[ -n "$log" ] || die "--log FILE is required (one joblog per batch)"
[[ $jobs =~ ^[1-9][0-9]*$ ]] || die "invalid --jobs: $jobs (expected 1, 2, ...)"
[[ $delay =~ ^[0-9]+([.][0-9]+)?$ ]] || die "invalid --delay: $delay (expected seconds)"
[ $# -ge 1 ] || die "no command given after --"
command -v parallel >/dev/null 2>&1 || die "missing required tool: GNU parallel"

# Stage stdin once: batch-run owns the item stream from here on.
input=$(mktemp)
trap 'rm -f -- "$input"' EXIT
cat >"$input"

# NUL-separated when the stream carries NUL bytes (find -print0), else one
# item per line. A trailing separator is appended so the record count is
# exact; parallel tolerates it either way.
items=0
if [ -s "$input" ] && ! cmp -s "$input" <(tr -d '\0' <"$input"); then
        [ "$(tail -c1 "$input" | od -An -tu1 | tr -d '[:space:]')" = 0 ] || printf '\0' >>"$input"
        items=$(tr -cd '\0' <"$input" | wc -c)
        read_args=(-0 --arg-file "$input")
else
        grep -v '^$' "$input" >"$input.lines" || true
        items=$(wc -l <"$input.lines")
        read_args=(--arg-file "$input.lines")
fi

log_dir=${log%/*}
[ "$log_dir" = "$log" ] || mkdir -p -- "$log_dir"

[ "$fresh" -eq 1 ] && rm -f -- "$log"

resume_args=()
[ -f "$log" ] && resume_args=(--resume-failed)

start=0
[ -f "$log" ] && start=$(wc -l <"$log")
status=0
parallel --will-cite --tag --joblog "$log" ${resume_args[@]+"${resume_args[@]}"} \
        --jobs "$jobs" --delay "$delay" \
        ${read_args[@]+"${read_args[@]}"} -- "$@" || status=$?
[ "$status" -ne 255 ] || die "GNU parallel itself failed (exit 255)"

# Rows appended by this run (the log header, if any, sorts out as non-numeric).
summary=$(tail -n +"$((start + 1))" "$log" | awk -F'\t' '
        $1 ~ /^[0-9]+$/ {
                if ($7 == 0) ok++
                else bad++
        }
        END { printf "%d %d", ok + 0, bad + 0 }')
read -r ok failed <<<"$summary"
skipped=$((items - ok - failed))

echo "batch-run: ${items} items: ${ok} ok, ${failed} failed, ${skipped} skipped (already done)" >&2
if [ "$failed" -gt 0 ]; then
        echo "batch-run: failed jobs (rerun the same command to retry):" >&2
        tail -n +"$((start + 1))" "$log" | awk -F'\t' '$1 ~ /^[0-9]+$/ && $7 != 0 { print "  " $9 }' >&2
        exit 1
fi
