#!/usr/bin/env bash
# archive-verify-sweep — sharded, parallel `pkit archive verify` over CAS links.
#
# Collects the unique sha256 ids behind a repo tree's CAS symlinks and runs
# `pkit archive verify sha256:<id>` on each via GNU parallel, exiting
# non-zero when any check fails. Use --delay to be gentle with rate-limited
# remotes such as wayback:.
#
# Usage:
#   scripts/archive-verify-sweep [OPTIONS] [TREE]
#
# Options:
#   --jobs N       parallel jobs (default 4)
#   --delay SECS   seconds between job starts (rate limiting; default 0)
#   --shard N/M    verify only every M-th id, 1-based; a bare N means N/31
#                  (a daily sweep is --shard "$(date +%-d)")
#   -h, --help     show this help
#
# TREE defaults to '.'. Requires: GNU find, GNU parallel, pkit on PATH.
set -euo pipefail

jobs=4
delay=0
shard=""
tree=""
parse_error() {
    echo "archive-verify-sweep: $1" >&2
    exit 2
}

usage() {
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
    case $1 in
        --jobs)
            [ $# -ge 2 ] || parse_error "--jobs needs a value"
            jobs=$2
            shift 2
            ;;
        --delay)
            [ $# -ge 2 ] || parse_error "--delay needs a value"
            delay=$2
            shift 2
            ;;
        --shard)
            [ $# -ge 2 ] || parse_error "--shard needs a value"
            shard=$2
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --*)
            parse_error "unknown option: $1"
            ;;
        *)
            [ -z "$tree" ] || parse_error "unexpected argument: $1"
            tree=$1
            shift
            ;;
    esac
done
tree=${tree:-.}

if [ -n "$shard" ]; then
    case $shard in
        */*)
            shard_n=${shard%%/*}
            shard_m=${shard##*/}
            ;;
        *)
            shard_n=$shard
            shard_m=31
            ;;
    esac
    case $shard_n in '' | *[!0-9]*) parse_error "invalid shard: $shard" ;; esac
    case $shard_m in '' | *[!0-9]* | 0) parse_error "invalid shard: $shard" ;; esac
    [ "$shard_n" -ge 1 ] || parse_error "invalid shard: $shard"
    [ "$shard_n" -le "$shard_m" ] || parse_error "invalid shard: $shard"
fi

command -v find >/dev/null 2>&1 || {
    echo "archive-verify-sweep: missing required tool: find" >&2
    exit 2
}
[ -d "$tree" ] || {
    echo "archive-verify-sweep: no such directory: $tree" >&2
    exit 2
}

# One unique sha256 id per CAS symlink target; foreign links fall through.
# grep exits 1 when nothing matches (a tree with no CAS links), hence || true.
ids=$(find "$tree" -type l -printf '%l\n' | sed 's|.*/||' | grep -E '^[0-9a-f]{64}$' | sort -u || true)

if [ -n "$shard" ]; then
    ids=$(printf '%s\n' "$ids" | awk -v n="$shard_n" -v m="$shard_m" 'NR % m == (n - 1) % m')
fi

if [ -z "$ids" ]; then
    echo "archive-verify-sweep: no CAS-linked files found in $tree" >&2
    exit 1
fi

command -v parallel >/dev/null 2>&1 || {
    echo "archive-verify-sweep: missing required tool: GNU parallel" >&2
    exit 2
}
command -v pkit >/dev/null 2>&1 || {
    echo "archive-verify-sweep: missing required tool: pkit (on PATH)" >&2
    exit 2
}

status=0
printf '%s\n' "$ids" | parallel --tag --jobs "$jobs" --delay "$delay" \
    "pkit archive verify sha256:{}" || status=$?

if [ "$status" -ne 0 ]; then
    echo "archive-verify-sweep: some checks failed" >&2
    exit 1
fi
